# --- Supabase (required for the portal; the resume builder works without it) --
# Safe to expose: these ship in the browser bundle and are protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only. NEVER prefix these NEXT_PUBLIC_ and never commit them. ------
# Bypasses row level security; used by the job ingestion route to write jobs
# and notifications. Supabase dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=

# Free job feed. Register at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Shared secret the cron sends as `Authorization: Bearer <secret>` so the
# ingestion endpoint is not open to the world. Generate with:
#   openssl rand -hex 32
INGEST_SECRET=

# --- Email digests (optional) ------------------------------------------------
# Job alert digests. Without this, alerts still produce in-app notifications;
# the "email me" checkbox simply has no effect. Key from https://resend.com
RESEND_API_KEY=
# Must be a sender Resend has verified for your domain. The default,
# onboarding@resend.dev, works immediately but only delivers to the address
# that owns the Resend account — fine for testing, not for real users.
EMAIL_FROM="CareerSetu <onboarding@resend.dev>"
# Only needed if links in emails point somewhere wrong; Vercel supplies the
# production host automatically.
NEXT_PUBLIC_SITE_URL=
